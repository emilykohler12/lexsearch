# Copiá este archivo como .env (en la raíz del repo) y completá lo que falte.
# El .env NUNCA se commitea: está en .gitignore.

# ─── Base de datos (contenedor Docker) ─────────────────────────────
POSTGRES_USER=lexsearch
POSTGRES_PASSWORD=lexsearch_dev
POSTGRES_DB=lexsearch
POSTGRES_PORT=5433
DATABASE_URL=postgresql://lexsearch:lexsearch_dev@localhost:5433/lexsearch
TEST_DATABASE_URL=postgresql://lexsearch:lexsearch_dev@localhost:5433/lexsearch_test

# ─── API ──────────────────────────────────────────────────────────
PORT=4000
# Solo esta computadora. En Docker la imagen de la API usa 0.0.0.0 (lo expone Docker, no la red).
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5180
LOG_LEVEL=info

# ─── Acceso (usuario y contraseña) ────────────────────────────────
# Sin esto el sistema queda abierto a quien llegue a su dirección: está bien en tu computadora (solo escucha en
# 127.0.0.1), pero en producción es obligatorio. Para generarlo:  npm run auth:hash -w backend
# (pide el usuario y la contraseña y muestra las dos líneas de abajo, ya completas; la contraseña no se guarda).
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
# Segundo factor: el código de 6 dígitos de una app de autenticación (obligatorio en producción). Para generarlo:
#   npm run auth:totp -w backend   (muestra la línea de abajo y cómo cargarla en la app)
AUTH_TOTP_SECRET=
# La sesión se cierra después de tantas horas sin usarla.
AUTH_IDLE_HOURS=12
# La cookie de sesión viaja solo por HTTPS. Vacío = sí en producción, no en desarrollo.
COOKIE_SECURE=

# ─── Despliegue con docker-compose.prod.yml ─────────────────────────
# Dirección con la que se entra y certificado de HTTPS (el README explica cada opción):
#   internal = uno propio, para probar en tu computadora | auto = Let's Encrypt (dominio propio)
#   files = tus archivos ./tls/cert.pem y ./tls/key.pem (por ejemplo, los de Tailscale)
SITE_ADDRESS=localhost
TLS_MODE=internal
# 127.0.0.1 = solo esta computadora; 0.0.0.0 = abierto a la red (solo con usuario, contraseña y HTTPS de verdad)
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=443
HTTP_PORT=80
# Copias de seguridad cifradas. BACKUP_AGE_RECIPIENT es OBLIGATORIA: es la clave PÚBLICA (age1…) con la que se cifran;
# la secreta se guarda fuera del servidor. Se crea con:  docker run --rm alpine sh -c "apk add -q age && age-keygen"
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=./backups
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14

# ─── Archivos subidos ─────────────────────────────────────────────
# Ruta relativa a la carpeta backend/ (o absoluta)
STORAGE_DIR=storage
MAX_UPLOAD_MB=50

# ─── Embeddings (corren en tu máquina; los documentos no salen de acá) ─
EMBEDDING_MODEL=Xenova/multilingual-e5-base
MODELS_CACHE_DIR=.cache/models
# Similitud mínima (0 a 1) para mostrar un fragmento encontrado solo por significado.
# Calibrada para multilingual-e5-base; más alta = menos resultados, pero más precisos.
SEARCH_MIN_SIMILARITY=0.8

# ─── IA: Gemini (Google) ──────────────────────────────────────────
# Sin API key la biblioteca y la búsqueda funcionan igual; solo se desactivan
# las respuestas redactadas por IA. La clave se crea en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Si el modelo principal está saturado, sin cupo o tarda más de 30 s, se prueban estos en orden (separados por coma)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
# Cuánto razona antes de responder: minimal | low | medium | high (más alto = más lento)
GEMINI_THINKING_LEVEL=low
