// Modelo de datos de LexSearch.
// Fase 1: biblioteca de documentos + fragmentos (RAG) + registro de interacciones con la IA.
// Fase 2: borradores. Fase 3: clientes. Fase 4: plazos, días inhábiles y avisos.
// Fase 5: expedientes y actuaciones (la línea de tiempo).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentCategory {
  LEGISLACION // leyes, códigos, decretos, resoluciones
  JURISPRUDENCIA // fallos y sentencias
  DOCTRINA // artículos, libros, comentarios
  MODELO // modelos propios de contratos y escritos
  ESCRITO // escritos presentados en expedientes
  OTRO
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Document {
  id             String           @id @default(uuid()) @db.Uuid
  title          String
  originalName   String           @map("original_name")
  mimeType       String           @map("mime_type")
  sizeBytes      Int              @map("size_bytes")
  sha256         String           @unique
  /// Ruta relativa a STORAGE_DIR (nunca el nombre original del archivo).
  storagePath    String           @map("storage_path")
  category       DocumentCategory @default(OTRO)
  status         DocumentStatus   @default(PENDING)
  errorMessage   String?          @map("error_message")
  pageCount      Int?             @map("page_count")
  chunkCount     Int              @default(0) @map("chunk_count")
  charCount      Int?             @map("char_count")
  /// Páginas leídas con OCR (escaneos y fotos): su texto puede tener errores de lectura.
  ocrPageCount   Int              @default(0) @map("ocr_page_count")
  embeddingModel String?          @map("embedding_model")
  processedAt    DateTime?        @map("processed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  chunks         DocumentChunk[]
  /// Borradores que usaron este documento como modelo base.
  drafts         Draft[]
  /// Actuaciones de expedientes que tienen este documento como respaldo.
  proceedings    Proceeding[]

  @@index([category])
  @@index([status])
  @@map("documents")
}

/// Fragmento de texto de un documento con su embedding (lo usa el RAG).
/// Las filas se insertan con SQL crudo porque Prisma no maneja el tipo vector.
///
/// Parte de esta tabla la crea SQL escrito a mano en la migración inicial (columna
/// generada, índice HNSW). Los atributos de abajo existen para que `prisma migrate dev`
/// los reconozca y no intente borrarlos en migraciones futuras: no los quites.
model DocumentChunk {
  id           String                      @id @default(uuid()) @db.Uuid
  documentId   String                      @map("document_id") @db.Uuid
  /// Posición del fragmento dentro del documento (0, 1, 2...).
  ordinal      Int
  content      String
  pageStart    Int?                        @map("page_start")
  pageEnd      Int?                        @map("page_end")
  charCount    Int                         @map("char_count")
  /// Dimensión atada al modelo de embeddings (multilingual-e5-base = 768).
  embedding    Unsupported("vector(768)")?
  /// Columna GENERATED de Postgres para la búsqueda por palabras (español, sin acentos).
  searchVector Unsupported("tsvector")?    @default(dbgenerated("to_tsvector('es_unaccent'::regconfig, content)")) @map("search_vector")
  createdAt    DateTime                    @default(now()) @map("created_at")
  document     Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  /// Índice HNSW (vector_cosine_ops) creado en la migración inicial.
  @@index([embedding], map: "document_chunks_embedding_hnsw_idx")
  @@index([searchVector], type: Gin)
  @@map("document_chunks")
}

enum InteractionStatus {
  SUCCESS
  FAILED
}

/// Historial de interacciones con los módulos de IA: qué se preguntó, qué contexto
/// recibió el modelo y qué respondió. Sirve para depurar prompts y como historial.
model AgentInteraction {
  id            String            @id @default(uuid()) @db.Uuid
  module        String
  input         Json
  context       Json?
  output        Json?
  model         String?
  promptVersion String?           @map("prompt_version")
  inputTokens   Int?              @map("input_tokens")
  outputTokens  Int?              @map("output_tokens")
  durationMs    Int?              @map("duration_ms")
  status        InteractionStatus
  errorMessage  String?           @map("error_message")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([module, createdAt])
  @@map("agent_interactions")
}

/// Borradores de escritos y contratos redactados por el agente (Fase 2).
model Draft {
  id                 String    @id @default(uuid()) @db.Uuid
  title              String
  /// Tipo de escrito (CARTA_DOCUMENTO, CONTRATO, DEMANDA...; ver drafts.schemas.ts).
  documentType       String    @map("document_type")
  instructions       String
  caseDetails        String    @map("case_details")
  templateDocumentId String?   @map("template_document_id") @db.Uuid
  /// Texto del borrador en Markdown; el abogado lo edita y lo guarda.
  content            String
  /// Fragmentos y documentos de la biblioteca que el agente consultó para redactarlo.
  sources            Json
  model              String?
  interactionId      String?   @map("interaction_id") @db.Uuid
  /// Cliente para el que se redactó (el agente lee su ficha). Si se borra el cliente, el borrador queda.
  clientId           String?   @map("client_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  templateDocument   Document? @relation(fields: [templateDocumentId], references: [id], onDelete: SetNull)
  client             Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([clientId])
  @@map("drafts")
}

/// Ficha de cliente (Fase 3): datos, contraparte, caso y documentación que falta reunir.
/// Los textos vacíos significan "sin dato": así la interfaz y el agente no manejan nulos.
model Client {
  id                   String   @id @default(uuid()) @db.Uuid
  fullName             String   @map("full_name")
  /// FISICA (persona humana) o JURIDICA (sociedad, asociación...).
  personType           String   @default("FISICA") @map("person_type")
  /// DNI, CUIT o CUIL, tal como lo escribe el abogado.
  documentNumber       String   @default("") @map("document_number")
  email                String   @default("")
  phone                String   @default("")
  address              String   @default("")
  counterpartyName     String   @default("") @map("counterparty_name")
  counterpartyDocument String   @default("") @map("counterparty_document")
  counterpartyAddress  String   @default("") @map("counterparty_address")
  /// Área de práctica (LABORAL, CIVIL...; ver clients.schemas.ts). Nula hasta definirla.
  practiceArea         String?  @map("practice_area")
  conflictSummary      String   @default("") @map("conflict_summary")
  /// Lo que el cliente pretende obtener.
  claim                String   @default("")
  /// Documentación que falta reunir: [{ id, text, done }].
  checklist            Json     @default("[]")
  /// Notas o transcripción de la primera reunión: de ahí sale la ficha.
  meetingNotes         String   @default("") @map("meeting_notes")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  drafts               Draft[]
  deadlines            Deadline[]
  cases                CaseClient[]

  @@index([fullName])
  @@map("clients")
}

/// Plazo procesal o contractual (Fase 4). El vencimiento se calcula con el calendario (calendar/business-days.ts).
model Deadline {
  id               String         @id @default(uuid()) @db.Uuid
  title            String
  /// Carátula, número de expediente y juzgado, en texto libre: lo que dice la cédula. El vínculo con el expediente es caseId.
  caseReference    String         @default("") @map("case_reference")
  notes            String         @default("")
  clientId         String?        @map("client_id") @db.Uuid
  /// Expediente al que pertenece. Si se borra el expediente, el plazo se conserva sin vínculo.
  caseId           String?        @map("case_id") @db.Uuid
  /// Fecha de la notificación: el cómputo empieza al día siguiente.
  notificationDate DateTime       @map("notification_date") @db.Date
  days             Int
  /// BUSINESS (días hábiles) o CALENDAR (días corridos).
  dayType          String         @map("day_type")
  /// Último día del plazo. Se calcula al guardar y se recalcula si cambia el calendario de días inhábiles.
  dueDate          DateTime       @map("due_date") @db.Date
  /// PENDING o DONE. "Vencido" no se guarda: es un plazo pendiente cuya fecha ya pasó.
  status           String         @default("PENDING")
  completedAt      DateTime?      @map("completed_at")
  /// Frase del documento que fija el plazo (cuando se analizó una cédula o una resolución).
  sourceQuote      String         @default("") @map("source_quote")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  client           Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case             Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  notifications    Notification[]

  @@index([status, dueDate])
  @@index([clientId])
  @@index([caseId])
  @@map("deadlines")
}

/// Días en que no corren los plazos y que no son feriados nacionales (esos se calculan solos):
/// feria judicial, asuetos, feriados provinciales o municipales, días no laborables decretados.
model NonWorkingDay {
  id        String   @id @default(uuid()) @db.Uuid
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([startDate])
  @@map("non_working_days")
}

/// Avisos generados por el sistema: hoy, plazos por vencer; más adelante, novedades normativas.
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  /// DEADLINE_SOON_3, DEADLINE_SOON_1, DEADLINE_TODAY o DEADLINE_OVERDUE.
  kind       String
  deadlineId String?   @map("deadline_id") @db.Uuid
  title      String
  message    String
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  deadline   Deadline? @relation(fields: [deadlineId], references: [id], onDelete: Cascade)

  /// Un solo aviso de cada tipo por plazo (el vigía puede correr muchas veces).
  @@unique([deadlineId, kind])
  @@index([readAt, createdAt])
  @@map("notifications")
}

/// Expediente (Fase 5): el caso que el abogado lleva para uno o más clientes.
model Case {
  id           String       @id @default(uuid()) @db.Uuid
  /// Carátula: «Pérez, Juan c/ Gómez, Ana s/ daños y perjuicios».
  title        String
  /// Número de expediente tal como lo escribe el abogado (45678/2026).
  number       String       @default("")
  /// Juzgado o tribunal.
  court        String       @default("")
  /// Área de práctica (LABORAL, CIVIL...; ver clients.schemas.ts). Nula hasta definirla.
  practiceArea String?      @map("practice_area")
  /// ACTIVE (en trámite), PAUSED (paralizado) o CLOSED (terminado o archivado).
  status       String       @default("ACTIVE")
  notes        String       @default("")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  clients      CaseClient[]
  proceedings  Proceeding[]
  deadlines    Deadline[]

  @@index([status, updatedAt])
  @@map("cases")
}

/// Un expediente puede tener varios clientes y un cliente varios expedientes.
/// Si se borra cualquiera de los dos, solo se pierde el vínculo.
model CaseClient {
  caseId   String @map("case_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid
  case     Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([caseId, clientId])
  @@index([clientId])
  @@map("case_clients")
}

/// Actuación (Fase 5): cada hecho con fecha dentro de un expediente (un escrito, una resolución,
/// una notificación, una audiencia...). Alimenta la línea de tiempo.
model Proceeding {
  id          String    @id @default(uuid()) @db.Uuid
  caseId      String    @map("case_id") @db.Uuid
  date        DateTime  @db.Date
  /// ESCRITO, RESOLUCION, NOTIFICACION, AUDIENCIA, PRUEBA u OTRO (ver cases.schemas.ts).
  kind        String
  title       String
  description String    @default("")
  /// Orden entre las actuaciones de un mismo día: el de aparición en el texto cuando vienen de una lectura con IA.
  position    Int       @default(0)
  /// MANUAL (la cargó el abogado) o AI (la propuso la IA al leer un texto y el abogado la confirmó).
  source      String    @default("MANUAL")
  /// Frase del texto leído que respalda la actuación (solo cuando la propuso la IA).
  sourceQuote String    @default("") @map("source_quote")
  /// Documento de la biblioteca que corresponde a la actuación (el escrito, la resolución).
  documentId  String?   @map("document_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([caseId, date])
  @@index([documentId])
  @@map("proceedings")
}
